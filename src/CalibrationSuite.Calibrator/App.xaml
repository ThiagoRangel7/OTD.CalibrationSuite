<Application x:Class="CalibrationSuite.Calibrator.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="#203044"/><Setter Property="Background" Value="#F5F7FB"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#203044"/>
   <Setter Property="BorderBrush" Value="#B9C6D6"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#1768AB"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#1768AB"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#1768AB"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#1768AB"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#B9C6D6"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Application.Resources>
</Application>
